{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mis Cercas",
  "version": "3.0.0",
  "identifier": "com.michael.miscercas",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Michael Tellez Oviedo",
    "copyright": "© Michael Tellez Oviedo",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SpanishInternational", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
